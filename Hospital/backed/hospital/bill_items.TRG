TYPE=TRIGGERS
triggers='CREATE DEFINER=`root`@`localhost` TRIGGER `update_bill_total_after_item_insert` AFTER INSERT ON `bill_items` \nFOR EACH ROW \nBEGIN\n    DECLARE bill_total DECIMAL(12,2);\n    DECLARE bill_paid DECIMAL(12,2);\n    \n    SELECT COALESCE(SUM(total_amount), 0) INTO bill_total\n    FROM bill_items \n    WHERE bill_id = NEW.bill_id;\n    \n    SELECT paid_amount INTO bill_paid\n    FROM billing \n    WHERE id = NEW.bill_id;\n    \n    UPDATE billing \n    SET total_amount = bill_total,\n        balance_amount = bill_total - bill_paid,\n        status = CASE \n            WHEN bill_total <= bill_paid THEN \'paid\'\n            WHEN bill_paid > 0 THEN \'partial\'\n            ELSE \'pending\'\n        END\n    WHERE id = NEW.bill_id;\nEND' 'CREATE DEFINER=`root`@`localhost` TRIGGER `update_bill_total_after_item_update` AFTER UPDATE ON `bill_items` \nFOR EACH ROW \nBEGIN\n    DECLARE bill_total DECIMAL(12,2);\n    DECLARE bill_paid DECIMAL(12,2);\n    \n    SELECT COALESCE(SUM(total_amount), 0) INTO bill_total\n    FROM bill_items \n    WHERE bill_id = NEW.bill_id;\n    \n    SELECT paid_amount INTO bill_paid\n    FROM billing \n    WHERE id = NEW.bill_id;\n    \n    UPDATE billing \n    SET total_amount = bill_total,\n        balance_amount = bill_total - bill_paid,\n        status = CASE \n            WHEN bill_total <= bill_paid THEN \'paid\'\n            WHEN bill_paid > 0 THEN \'partial\'\n            ELSE \'pending\'\n        END\n    WHERE id = NEW.bill_id;\nEND' 'CREATE DEFINER=`root`@`localhost` TRIGGER `update_bill_total_after_item_delete` AFTER DELETE ON `bill_items` \nFOR EACH ROW \nBEGIN\n    DECLARE bill_total DECIMAL(12,2);\n    DECLARE bill_paid DECIMAL(12,2);\n    \n    SELECT COALESCE(SUM(total_amount), 0) INTO bill_total\n    FROM bill_items \n    WHERE bill_id = OLD.bill_id;\n    \n    SELECT paid_amount INTO bill_paid\n    FROM billing \n    WHERE id = OLD.bill_id;\n    \n    UPDATE billing \n    SET total_amount = bill_total,\n        balance_amount = bill_total - bill_paid,\n        status = CASE \n            WHEN bill_total <= bill_paid THEN \'paid\'\n            WHEN bill_paid > 0 THEN \'partial\'\n            ELSE \'pending\'\n        END\n    WHERE id = OLD.bill_id;\nEND'
sql_modes=1098907648 1098907648 1098907648
